{
    "python.testing.pytestArgs": [
        "tests/unit",
        // "tests/integration",
        "--cov=app",
        "--no-cov-on-fail",
        "--cov-fail-under=90",
        // "--log-file=tests.log",
        "--log-format=%(asctime)s %(thread)d %(levelname)s %(name)s: %(message)s",
        "--log-date-format=%H:%M:%S.%f",
        "--color=yes",
        "-rfE",
        "--disable-warnings",
        "--show-capture=log",
        "--show-capture=stdout",
        "--durations=5"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "debugpy.debugJustMyCode": false,
    "window.autoDetectColorScheme": true,
    "workbench.preferredDarkColorTheme": "Dark Modern",
    "workbench.preferredLightColorTheme": "Light Modern",
    "window.title": "${dirty}${activeRepositoryName}${separator}${rootName}${separator}${profileName}",
    "ruff.lineLength": 120,
    "files.exclude": {
        "**/.pytest_cache/": true,
        "**/__pycache__/": true,
        "**/.ruff_cache/": true,
        "**/*.egg-info/": true,
        "**/.venv/": true,
        "**/.vscode/": true,
        "**/.coverage/": true,
        "**/uv.lock/": true,
        "**/.python-version/": true,
    }
}